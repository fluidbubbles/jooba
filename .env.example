# Copy to `.env` in this directory for docker compose (optional; defaults match below).
POSTGRES_USER=jooba
POSTGRES_PASSWORD=jooba
POSTGRES_DB=jooba
DATABASE_URL=postgresql+asyncpg://jooba:jooba@db:5432/jooba
REDIS_URL=redis://redis:6379/0

# Nylas (get from dashboard.nylas.com)
NYLAS_CLIENT_ID=
NYLAS_API_KEY=
NYLAS_CALLBACK_URL=http://localhost:8000/api/nylas/callback

# App
SECRET_KEY=change-me-to-a-random-string
UNSUBSCRIBE_BASE_URL=http://localhost:8000/api/unsubscribe
FRONTEND_URL=http://localhost:3000

# Provider selection (nylas = real emails, mock = log only)
EMAIL_PROVIDER=nylas
LLM_PROVIDER=openai

# OpenAI (for reply classification in Plan 5)
OPENAI_API_KEY=
