# Copy to backend/.env and fill in values. App will not start without these.

# Infrastructure
DATABASE_URL=postgresql+asyncpg://jooba:jooba@db:5432/jooba
REDIS_URL=redis://redis:6379/0

# Nylas (https://dashboard.nylas.com)
NYLAS_CLIENT_ID=your-nylas-client-id
NYLAS_API_KEY=your-nylas-api-key
NYLAS_CALLBACK_URL=http://localhost:8000/api/nylas/callback

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-key

# App
SECRET_KEY=generate-a-random-string
UNSUBSCRIBE_BASE_URL=http://localhost:8000/api/unsubscribe
FRONTEND_URL=http://localhost:3000

# Providers
EMAIL_PROVIDER=nylas       # nylas | mock
LLM_PROVIDER=openai        # openai | mock

# Optional
# NYLAS_WEBHOOK_URL=        # set for real-time webhooks (requires public URL)
